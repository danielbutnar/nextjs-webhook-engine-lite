# Upstash Redis REST Credentials (stateless HTTP for serverless lambdas)
# Leave as placeholder or omit to auto-activate local dev in-memory fallback
UPSTASH_REDIS_REST_URL="https://example.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-database-token"

# Shared HMAC Secret Key for Webhook Ingestion
WEBHOOK_SECRET="local_dev_secret_key_12345"